# Copy to .env and fill in real values — never commit .env
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/claims_platform
AWS_REGION=us-east-1

# Production only (infra/docker-compose.prod.yml): the origin the browser loads the site from,
# e.g. http://<elastic-ip>. It becomes the frontend's API base URL and both services'
# CORS_ALLOWED_ORIGIN. Not used by the dev compose file.
# PUBLIC_ORIGIN=http://<elastic-ip>

# rag-assistant-service (Phase 7a) — hosted LLM providers, tried in order: Groq, then Gemini.
# Placeholders only; real keys go in .env.
GROQ_API_KEY=your-groq-key-here
GEMINI_API_KEY=your-gemini-key-here
# Optional overrides (defaults live in services/rag-assistant-service/assistant/config.py):
# GROQ_MODEL=
# GEMINI_MODEL=
# NLI_MODEL=cross-encoder/nli-deberta-v3-small
# GROUNDEDNESS_THRESHOLD=0.5   # kept after Phase 7b calibration failed its criterion; not a calibrated value
# RETRIEVAL_TOP_K=3
# CORS_ALLOWED_ORIGIN=http://localhost:3000   # frontend origin allowed to call /assistant/ask

# claims-intake-service (Phase 8b): admin accounts for appeal review. Placeholders only.
# ADMIN_TOKEN_SECRET signs admin session tokens; at least 32 bytes or the service won't start.
# Generate with: openssl rand -base64 48
ADMIN_TOKEN_SECRET=replace-with-output-of-openssl-rand-base64-48
# Needed once, at admin sign-up. Unset or empty disables admin sign-up entirely. Change or remove
# it (and restart) to close sign-ups; existing admins keep working.
ADMIN_SIGNUP_CODE=replace-with-a-long-random-code

# Appeal documents. Dev compose uses a local volume; the prod compose file sets
# APPEAL_STORAGE_MODE=s3 and requires S3_BUCKET (the private bucket the instance role can use).
# S3_BUCKET=<private-bucket-name>
