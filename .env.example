# Copy to .env and fill in real values — never commit .env
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/claims_platform
AWS_REGION=us-east-1

# rag-assistant-service (Phase 7a) — hosted LLM providers, tried in order: Groq, then Gemini.
# Placeholders only; real keys go in .env.
GROQ_API_KEY=your-groq-key-here
GEMINI_API_KEY=your-gemini-key-here
# Optional overrides (defaults live in services/rag-assistant-service/assistant/config.py):
# GROQ_MODEL=
# GEMINI_MODEL=
# NLI_MODEL=cross-encoder/nli-deberta-v3-small
# GROUNDEDNESS_THRESHOLD=0.5   # PROVISIONAL until Phase 7b calibration
# RETRIEVAL_TOP_K=3
